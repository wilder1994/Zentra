APP_NAME=Zentra
APP_ENV=local
APP_KEY=

# Súper admin. En producción son obligatorias (solo .env del servidor, no Git).
# Local: si se omiten, el seeder usa admin@control-acceso.test / Admin123!
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
APP_DEBUG=true
APP_TIMEZONE=America/Bogota
APP_URL=http://zentra.test

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=zentra
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@zentra.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Reverb (gratis, en el VPS). BROADCAST_CONNECTION=reverb cuando el proceso esté arriba.
# PHP publica a 127.0.0.1:8080; el navegador usa wss al dominio (VITE_*).
# Sin socket conectado el tablero usa sondeo JSON cada 12 s. Local: puerto 8080. VPS: REVERB_SERVER_PORT=6001 (ver docs/HOSTING-VPS.md).
REVERB_APP_ID=zentra
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_BROADCAST_HOST=127.0.0.1
REVERB_BROADCAST_PORT=8080
REVERB_BROADCAST_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Google Maps — dashboard plataforma (/admin)
# Crear clave en: https://console.cloud.google.com/google/maps-apis
# APIs requeridas: Maps JavaScript API
# Restricción HTTP referrer (local): http://zentra.test/*  http://localhost/*
GOOGLE_MAPS_API_KEY=
# Roads API (snap historial): clave SIN restricción de sitios web (IP o ninguna). Si se omite, se usa GOOGLE_MAPS_API_KEY.
GOOGLE_MAPS_SERVER_API_KEY=
GOOGLE_MAPS_DEFAULT_LAT=4.5709
GOOGLE_MAPS_DEFAULT_LNG=-74.2973
GOOGLE_MAPS_DEFAULT_ZOOM=6

# Observatorio: minutos para unir reportes del mismo colegio y tipo en un evento abierto
OBSERVATORY_MERGE_WINDOW_MINUTES=60

# Ciclo de acceso / cobranza (paquetes siguen independientes)
SUBSCRIPTION_GRACE_DAYS=5
SUBSCRIPTION_REMINDER_DAYS=5
SUBSCRIPTION_ARCHIVE_AFTER_SUSPENDED_DAYS=90

# Facturación plataforma (demo = facturas sin PT DIAN)
BILLING_MODE=demo
BILLING_DEMO_PREFIX=DEMO
BILLING_GATEWAY_DRIVER=local
BILLING_SIGNUP_INTENT_TTL_HOURS=24
BILLING_ALLOW_PUBLIC_REGISTER=false

# App de Supervisión (PWA). Vacío: en .test → zentra_supervision.; en hosting → {APP_URL}/campo
SUPERVISION_PWA_URL=http://zentra_supervision.test

# Preview de planillas xlsx (PDF). Vacío = auto /usr/bin/soffice. off = no convertir (tests / Laragon).
# LIBREOFFICE_BIN=
